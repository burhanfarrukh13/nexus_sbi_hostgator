APP_NAME="Nexus SBI API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelprefix_nexus
DB_USERNAME=cpanelprefix_user
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
STORAGE_SIGNING_SECRET=
CORS_ALLOWED_ORIGINS=https://www.example.com
PRIVATE_STORAGE_PATH=/home/ACCOUNT/private/nexus

# OpenRouter embeddings (must return vectors with the configured dimensions).
OPENROUTER_EMBEDDINGS_API_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDINGS_DIMENSIONS=1536
OPENROUTER_TIMEOUT_SECONDS=30

# Ollama Cloud model for AI Notebook chat and test assessment; vision support is required for answer images.
# Use an Ollama Cloud-compatible HTTPS endpoint; localhost is not reachable from HostGator.
OLLAMA_API_URL=https://ollama.com/v1/chat/completions
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=90
