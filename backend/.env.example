APP_NAME="Nexus SBI API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelprefix_nexus
DB_USERNAME=cpanelprefix_user
DB_PASSWORD=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
STORAGE_SIGNING_SECRET=
CORS_ALLOWED_ORIGINS=https://www.example.com
PRIVATE_STORAGE_PATH=/home/ACCOUNT/private/nexus

# OpenRouter embeddings (must return vectors with the configured dimensions).
OPENROUTER_EMBEDDINGS_API_URL=https://openrouter.ai/api/v1/embeddings
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDINGS_DIMENSIONS=1536
AI_NOTEBOOK_MIN_SOURCE_SIMILARITY=0.30
OPENROUTER_TIMEOUT_SECONDS=30

# OpenAI-compatible chat provider for AI Notebook and test assessment.
# OLLAMA_* names are retained for compatibility; use a vision model for answer images.
OLLAMA_API_URL=https://openrouter.ai/api/v1/chat/completions
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_CHAT_TIMEOUT_SECONDS=60
OLLAMA_CONNECT_TIMEOUT_SECONDS=15
# Maximum output tokens for a complete AI test assessment.
AI_GRADING_MAX_TOKENS=8192
# Calendar day used for the AI Notebook daily question allowance.
AI_NOTEBOOK_DAY_RESET_TIMEZONE=Asia/Karachi
# Maximum simultaneous AI Notebook provider requests; additional questions are queued.
NOTEBOOK_MAX_CONCURRENT=8
PDFTOPPM_BINARY=pdftoppm

# Background grading (cPanel cron runs `php artisan ai-tests:grade-pending` every 15 minutes).
# Typed answers are queued too, so web requests never wait on the AI provider.
GRADING_QUEUE_TYPED=true
# Submissions graded at the same time (also the number of cron workers that may run at once).
GRADING_WORKERS=2
# A submission stuck in PROCESSING for this many minutes is treated as a crashed run.
GRADING_STALE_MINUTES=45
# Stop starting new submissions after this many seconds (keep below the 900-second cron interval).
GRADING_RUN_SECONDS=780
