{
  "name": "nexus-sbi/hostgator-api",
  "type": "project",
  "description": "PHP API deployment scaffold for Nexus SBI on HostGator",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-filter": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-hash": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-pcre": "*",
    "ext-session": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "smalot/pdfparser": "^2.12",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
