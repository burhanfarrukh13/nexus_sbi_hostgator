<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="JWT_ACCESS_SECRET" value="test-access-secret-at-least-thirty-two-characters"/>
        <env name="JWT_REFRESH_SECRET" value="test-refresh-secret-at-least-thirty-two-characters"/>
        <env name="STORAGE_SIGNING_SECRET" value="test-storage-secret-at-least-thirty-two-characters"/>
        <env name="OPENROUTER_EMBEDDINGS_API_URL" value="https://openrouter.example.test/api/v1/embeddings"/>
        <env name="OPENROUTER_API_KEY" value="test-key"/>
        <env name="OPENROUTER_EMBEDDINGS_MODEL" value="test-model"/>
        <env name="OPENROUTER_EMBEDDINGS_DIMENSIONS" value="3"/>
        <env name="OLLAMA_API_URL" value="https://ollama.example.test/v1/chat/completions"/>
        <env name="OLLAMA_API_KEY" value="test-key"/>
        <env name="OLLAMA_MODEL" value="test-model"/>
    </php>
</phpunit>
